{
  "governance_levels": {
    "light": {
      "description": "Minimal oversight, suitable for small, low-risk projects",
      "characteristics": {
        "documentation": "minimal",
        "approvals": "informal",
        "reporting": "lightweight",
        "stage_gates": "simplified"
      },
      "required_processes": [
        "Project Initiation",
        "Scope Definition",
        "Basic Planning",
        "Execution Management",
        "Project Closure"
      ],
      "optional_processes": [
        "Risk Management",
        "Quality Assurance",
        "Stakeholder Management"
      ]
    },
    "moderate": {
      "description": "Balanced governance with regular checkpoints and reviews",
      "characteristics": {
        "documentation": "standard",
        "approvals": "structured",
        "reporting": "regular",
        "stage_gates": "defined"
      },
      "required_processes": [
        "Project Charter",
        "Scope Management",
        "Schedule Management",
        "Risk Management",
        "Quality Management",
        "Stakeholder Management",
        "Communication Management",
        "Project Closure"
      ],
      "optional_processes": [
        "Procurement Management",
        "Resource Management",
        "Integration Management"
      ]
    },
    "heavy": {
      "description": "Comprehensive oversight with formal stage gates and approvals",
      "characteristics": {
        "documentation": "comprehensive",
        "approvals": "formal",
        "reporting": "detailed",
        "stage_gates": "rigorous"
      },
      "required_processes": [
        "Business Case Development",
        "Project Charter",
        "Comprehensive Planning",
        "Risk Management",
        "Quality Management",
        "Procurement Management",
        "Stakeholder Management",
        "Communication Management",
        "Integration Management",
        "Change Management",
        "Performance Management",
        "Project Closure"
      ],
      "optional_processes": [
        "Benefits Management",
        "Knowledge Management"
      ]
    }
  },
