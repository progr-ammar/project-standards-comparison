          "Frequent reviews",
          "Minimal bureaucracy",
          "Fast decision making"
        ]
      },
      "medium": {
        "threshold": "6-12 months",
        "recommendations": [
          "Balanced processes",
          "Regular checkpoints",
          "Moderate governance",
          "Structured decisions"
        ]
      },
      "long": {
        "threshold": ">12 months",
        "recommendations": [
          "Comprehensive processes",
          "Formal stage gates",
          "Full governance",
          "Documented decisions"
        ]
      }
    },
