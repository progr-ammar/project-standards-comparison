          "Lightweight documentation",
          "Informal communication",
          "Combined roles",
          "Simplified reporting"
        ]
      },
      "medium": {
        "threshold": "7-20",
        "recommendations": [
          "Moderate documentation",
          "Regular meetings",
          "Defined roles",
          "Standard reporting"
        ]
      },
      "large": {
        "threshold": ">20",
        "recommendations": [
          "Comprehensive documentation",
          "Formal communication",
          "Specialized roles",
          "Detailed reporting"
        ]
      }
    },
    "duration": {
      "short": {
        "threshold": "<6 months",
        "recommendations": [
